FROM python:3.12-slim

WORKDIR /app

COPY . /app/

RUN pip install --no-cache-dir \
    fastapi \
    "uvicorn[standard]" \
    langchain-openai \
    langchain-mcp-adapters \
    langgraph \
    "mcp<2" \
    httpx \
    python-dotenv

EXPOSE 8000

CMD ["uvicorn", "api_server:app", "--host", "0.0.0.0", "--port", "8000"]
